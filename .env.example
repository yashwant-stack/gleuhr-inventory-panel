# Names only. Values live in the hosting provider's secret store (Vercel → Settings → Environment
# Variables), never in git. See docs/BACKEND_PLAN.md §2 for where each one comes from.

# "live" = the panel reads /api/dataset (stock from Zoho, sales from the CRMs).
# Anything else (or unset) = the built-in sample data. Read at BUILD time: redeploy after changing it.
NEXT_PUBLIC_DATA_SOURCE=

# The panel's OWN database. Optional: when unset, the panel keeps an embedded database in PANEL_DATA_DIR
# (default .data/panel) — right for one long-running server, NOT for serverless hosting (its disk is wiped).
# For Vercel: the panel's own Supabase project, pooled connection string ("Transaction pooler", port 6543).
PANEL_DATABASE_URL=
PANEL_DATA_DIR=

# The panel's gateway in the CRM project (supabase/functions/inventory-panel-sql). When set, the panel keeps its
# tables in the CRM database's separate `inventory_panel` schema and reads the CRM through it (read-only).
# PANEL_SQL_KEY: 64 hex characters; only its SHA-256 is stored in inventory_panel.gateway_key.
PANEL_SQL_URL=
PANEL_SQL_KEY=

# The shared clinic + online CRM database, READ-ONLY. Either:
#  (a) its Supabase REST API — the panel only sends GET requests. The secret key bypasses the CRM's row-level
#      security: server-side only (never NEXT_PUBLIC_), rotate it when a read-only login exists;
SUPABASE_URL=
SUPABASE_SECRET_KEY=
#      (the publishable key and JWKS URL are for personal logins through the CRM's accounts — next stage)
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWKS_URL=
#  (b) or a read-only SQL login that may only SELECT clinics, retail_products, online_product_meta,
#      stock_movements, online_shopify_orders, product_sales, product_sale_lines, online_orders,
#      online_order_lines and online_offers (wins over (a) when set).
CRM_DATABASE_URL=

# Zoho Inventory (India data centre). Generate a NEW client secret + refresh token before go-live.
ZOHO_API_BASE=https://www.zohoapis.in
ZOHO_ACCOUNTS_BASE=https://accounts.zoho.in
ZOHO_ORG_ID=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# Vercel sends "Authorization: Bearer <CRON_SECRET>" to the scheduled sync. At least 16 characters.
CRON_SECRET=

# Interim gate until personal logins: the key people type to open the live panel. At least 12
# characters. Changing it logs everyone out.
PANEL_ACCESS_KEY=

# Reorder alerts (20 Nov 2026): email via Resend and WhatsApp via 360dialog, the same services as the clinic CRM.
# Sent after the morning sync for every product at its regimen's reorder point. Each channel stays off (and the
# Alerts page says which setting is missing) until all of its settings are set.
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. Gleuhr Inventory <alerts@gleuhr.com>
ALERT_EMAIL_FROM=
# Comma-separated addresses
ALERT_EMAIL_TO=
D360_API_KEY=
# Default https://waba-v2.360dialog.io
WA_360_API_URL=
# Comma-separated numbers with the country code, e.g. 919876543210
ALERT_WHATSAPP_TO=
# A WhatsApp template approved by Meta with ONE body variable {{1}} (the product list), e.g. inventory_reorder
WA_ALERT_TEMPLATE=
# The template's language code (default en)
WA_ALERT_TEMPLATE_LANG=
# Days before a product that is still due is alerted again (default 7)
ALERT_REPEAT_DAYS=
# Optional link in the messages (default: the Vercel production address)
ALERT_PANEL_URL=

# Optional: seconds a scheduled run may spend on Zoho calls (default 250). Lower it if the hosting
# plan stops functions sooner than 300 s; what is not read is read on the next run.
SYNC_TIME_BUDGET_SECONDS=
