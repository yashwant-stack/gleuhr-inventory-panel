# Names only. Values live in the hosting provider's secret store (Vercel → Settings → Environment
# Variables), never in git. See docs/BACKEND_PLAN.md §2 for where each one comes from.

# "live" = the panel reads /api/dataset (stock from Zoho, sales from the CRMs).
# Anything else (or unset) = the built-in sample data. Read at BUILD time: redeploy after changing it.
NEXT_PUBLIC_DATA_SOURCE=

# The panel's OWN Supabase project (its tables: supabase/migrations/). Use the pooled
# connection string ("Transaction pooler", port 6543); the panel never writes anywhere else.
PANEL_DATABASE_URL=

# The shared CRM database, READ-ONLY: a login that may only SELECT clinics, retail_products,
# stock_movements, online_shopify_orders, product_sales, product_sale_lines, online_orders,
# online_order_lines and online_offers.
# Created by the clinic CRM team through their own process; never their main login.
CRM_DATABASE_URL=

# Zoho Inventory (India data centre). Generate a NEW client secret + refresh token before go-live.
ZOHO_API_BASE=https://www.zohoapis.in
ZOHO_ACCOUNTS_BASE=https://accounts.zoho.in
ZOHO_ORG_ID=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# Vercel sends "Authorization: Bearer <CRON_SECRET>" to the scheduled sync. At least 16 characters.
CRON_SECRET=

# Interim gate until personal logins: the key people type to open the live panel. At least 12
# characters. Changing it logs everyone out.
PANEL_ACCESS_KEY=

# Optional: seconds a scheduled run may spend on Zoho calls (default 250). Lower it if the hosting
# plan stops functions sooner than 300 s; what is not read is read on the next run.
SYNC_TIME_BUDGET_SECONDS=
